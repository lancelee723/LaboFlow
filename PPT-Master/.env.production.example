# =============================================================================
# PPT-Master WebUI — Production environment template
#
# Copy to .env.production and fill in all __REPLACE__ placeholders before
# running `docker compose -f production.docker-compose.yml up -d`.
#
# NEVER commit .env.production to version control.
# =============================================================================

# =============================================================================
# === Required — application will refuse to start without these ===
# =============================================================================

# JWT signing secret — 32 random bytes as hex
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=__REPLACE_WITH_32_BYTES_HEX__

# AES-256 key used to encrypt LLM API keys at rest — 32 bytes base64-encoded
# Generate with: openssl rand -base64 32
SYSTEM_AES_KEY=__REPLACE_WITH_32_BYTES_BASE64__

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=pptmaster
POSTGRES_PASSWORD=__REPLACE_STRONG_DB_PASSWORD__
POSTGRES_DB=pptmaster

# Must match the POSTGRES_USER/PASSWORD/DB above.
# "postgres" is the service name in production.docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://pptmaster:__REPLACE_STRONG_DB_PASSWORD__@postgres:5432/pptmaster

# ---------------------------------------------------------------------------
# Storage & paths (defaults match Dockerfile.worker baked paths)
# ---------------------------------------------------------------------------
STORAGE_ROOT=/data

# Skill paths — the ppt-master skill is baked into the worker image.
#   PPTMASTER_SCRIPTS_DIR: subprocess targets (image_gen.py, image_search.py, etc.)
#   PPTMASTER_TEMPLATES_DIR: runtime template lookup
#   PPTMASTER_SKILL_TEMPLATES_ROOT: bootstrap built-in template sync source
#     (if unset, skill templates are NOT synced into the DB on boot)
PPTMASTER_SCRIPTS_DIR=/opt/pptmaster-skill/scripts
PPTMASTER_TEMPLATES_DIR=/opt/pptmaster-skill/templates
PPTMASTER_SKILL_TEMPLATES_ROOT=/opt/pptmaster-skill/templates

# ---------------------------------------------------------------------------
# Public URL — used for CORS, share links, and internal callbacks
# ---------------------------------------------------------------------------
PUBLIC_BASE_URL=https://your.domain

# ---------------------------------------------------------------------------
# Bootstrap admin (created once on first boot; skipped if any user exists)
# Must be a valid email address. Change the password after first login.
# ---------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@your.domain
INITIAL_ADMIN_PASSWORD=__REPLACE_STRONG_PASSWORD__

# =============================================================================
# === Recommended — provide at least one LLM provider key ===
# =============================================================================

# Anthropic Claude (recommended for best results)
ANTHROPIC_API_KEY=

# OpenAI GPT models
OPENAI_API_KEY=

# DashScope (Qwen) is configured via the Settings UI after first boot,
# not this file. Listed here for awareness only.
DASHSCOPE_API_KEY=

# =============================================================================
# === Optional — tune as needed ===
# =============================================================================

# JWT expiry in minutes (default: 1440 = 24 h)
# JWT_EXP_MINUTES=1440

# Sentry error tracking — optional, leave unset to disable
# SENTRY_DSN=https://your-key@sentry.io/your-project
