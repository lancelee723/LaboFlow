# =============================================================================
# pptmaster-webui — Worker image (FastAPI + LangGraph + skill scripts)
#
# Build context: pptmaster-webui repo root.
# Skill files (scripts/templates/references) are vendored under skills/ppt-master/.
# .dockerignore at the project root keeps secrets/dev-state/ai-image-comparison out.
#
# Toolchain: uv (matches dev). Multi-stage: builder compiles wheels, runtime
# only carries .venv + source + skill bundle + runtime native libs.
# =============================================================================

# ─── Builder ─────────────────────────────────────────────────────────────────
FROM python:3.12-slim AS builder

# Native build deps for compiling Python wheels that lack manylinux binaries
# on this platform (Pillow, cairosvg, curl_cffi, etc.).
ARG DEBIAN_MIRROR=deb.debian.org
RUN sed -i "s|deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources 2>/dev/null || true; \
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libcairo2-dev \
        libpango1.0-dev \
        libffi-dev \
        libcurl4-openssl-dev \
        libssl-dev \
        libjpeg-dev \
        zlib1g-dev \
        libfreetype6-dev \
        libwebp-dev \
        libtiff-dev \
    && rm -rf /var/lib/apt/lists/*

# uv: matches dev tooling, faster + uv.lock for reproducible builds
COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /uvx /usr/local/bin/

WORKDIR /app

# Layer 1 (cacheable across app-only edits): install deps from lockfile.
# --no-install-project skips the local package; --no-dev drops pytest/mypy/ruff.
COPY apps/worker/pyproject.toml apps/worker/uv.lock /app/apps/worker/
RUN cd /app/apps/worker \
    && uv sync --frozen --no-install-project --no-dev

# Layer 2: copy source + install the local package itself.
COPY apps/worker/src /app/apps/worker/src
RUN cd /app/apps/worker \
    && uv sync --frozen --no-dev


# ─── Runtime ─────────────────────────────────────────────────────────────────
FROM python:3.12-slim

# Runtime-only native libs (no -dev variants).
ARG DEBIAN_MIRROR=deb.debian.org
RUN sed -i "s|deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources 2>/dev/null || true; \
    apt-get update && apt-get install -y --no-install-recommends \
        libcairo2 \
        libpango-1.0-0 \
        libpangocairo-1.0-0 \
        libgdk-pixbuf2.0-0 \
        libffi8 \
        libcurl4 \
        libjpeg62-turbo \
        zlib1g \
        libfreetype6 \
        libwebp7 \
        libtiff6 \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Bring the prepared venv from the builder
COPY --from=builder /app/apps/worker/.venv /app/.venv

# App source + alembic + vendored skill
COPY apps/worker/src /app/src
COPY apps/worker/pyproject.toml /app/pyproject.toml
COPY alembic /app/alembic
COPY alembic.ini /app/alembic.ini
COPY skills/ppt-master /opt/pptmaster-skill

# Skill paths consumed at runtime by the worker
ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONPATH="/app/src" \
    PPTMASTER_SCRIPTS_DIR=/opt/pptmaster-skill/scripts \
    PPTMASTER_TEMPLATES_DIR=/opt/pptmaster-skill/templates \
    PPTMASTER_SKILL_TEMPLATES_ROOT=/opt/pptmaster-skill/templates \
    PYTHONUNBUFFERED=1

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

CMD ["uvicorn", "pptmaster.main:app", "--host", "0.0.0.0", "--port", "8000"]
