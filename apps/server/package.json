{
  "name": "@laboflow/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LaboFlow Server — skeleton in P0 (T0.1). Full NestJS implementation lands in P2 (PLAN T2.1-T2.9): auth/RBAC, model gateway, workspaces, admin API, audit.",
  "main": "./src/main.ts",
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "lint": "pnpm -w exec eslint apps/server/src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@laboflow/tsconfig": "workspace:*",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.0",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-fastify": "^11.2.3",
    "@node-rs/argon2": "^2.2.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  }
}
