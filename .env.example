# ─────────────────────────────────────────────────────────────
# Labo-Flow — Shared environment variables
# Copy to .env and fill in real values. This file is consumed
# by dev.sh / setup-all.sh and propagated to each component.
# ─────────────────────────────────────────────────────────────

# ══ Unified entry ══
NGINX_PORT=3008
PUBLIC_BASE_URL=http://localhost:3008

# ══ Clawith (main platform) ══
CLAWITH_FRONTEND_PORT=3080
CLAWITH_BACKEND_PORT=8008
# JWT_SECRET_KEY is read by Clawith backend AND shared with WeKnora/AIPPT
# for SSO. Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256

# ══ WeKnora (knowledge base) ══
WEKNORA_URL=/kb
WEKNORA_FRONTEND_PORT=8800
# JWT_SECRET in WeKnora/.env must match JWT_SECRET_KEY above for SSO
# SYSTEM_AES_KEY encrypts tenant.api_key, app secrets, etc. (32 bytes)
# Generate with: openssl rand -base64 32 | cut -c1-32
SYSTEM_AES_KEY=

# ══ AIPPT (AI PPT frontend) ══
AIPPT_PORT=5173
# When integrated with Clawith SSO, AIPPT will read this token secret
VITE_JWT_SECRET=${JWT_SECRET_KEY}
# Point AIPPT's CUSTOM LLM provider at Clawith's LLM proxy (Phase 4)
VITE_CUSTOM_LLM_URL=http://localhost:8008/api/v1/llm-proxy
VITE_CUSTOM_API_KEY=
VITE_CUSTOM_MODEL=gpt-4o-mini

# ══ Database (shared by Clawith) ══
DATABASE_URL=postgresql+asyncpg://clawith:clawith@localhost:5432/clawith?ssl=disable

# ══ PPT-Master (AI slide generator) ══
# Independent postgres container — schema/migrations isolated from clawith-postgres
PPTMASTER_POSTGRES_USER=pptmaster
PPTMASTER_POSTGRES_PASSWORD=change-me
PPTMASTER_POSTGRES_DB=pptmaster
# Bootstrap admin — used only on first boot to seed an admin row in case
# Clawith SSO is unavailable. Change the password after first login.
PPTMASTER_INITIAL_ADMIN_EMAIL=admin@local.dev
PPTMASTER_INITIAL_ADMIN_PASSWORD=change-me-strong
# SSO audience claim. Must equal the value Clawith mints in
# /api/enterprise/ppt-master/sso-token (default: ppt-master).
PPTMASTER_SSO_AUDIENCE=ppt-master
# JWT_SECRET_KEY, SYSTEM_AES_KEY, ANTHROPIC_API_KEY, OPENAI_API_KEY,
# DASHSCOPE_API_KEY, PUBLIC_BASE_URL are reused from sections above.
